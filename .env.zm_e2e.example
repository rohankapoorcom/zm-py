# ZoneMinder E2E test configuration
# Copy to .env.zm_e2e and fill in your values.
# Environment variables always take precedence over this file.

# Required: ZoneMinder server base URL
ZM_HOST=http://192.168.1.10

# Credentials (default: admin/admin)
ZM_USER=admin
ZM_PASSWORD=admin

# Server paths (defaults shown)
# ZM_SERVER_PATH=/zm/
# ZM_ZMS_PATH=/zm/cgi-bin/nph-zms

# SSL verification (default: false)
# ZM_VERIFY_SSL=false

# Set to 1 to enable write-tier tests (state changes, monitor function changes)
# ZM_E2E_WRITE=0
