        <mxCell id="zmclass" value="&lt;b&gt;ZoneMinder&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- _server_url: str&lt;br&gt;- _zms_url: str&lt;br&gt;- _session: requests.Session&lt;br&gt;- _auth_token: str | None&lt;br&gt;- _zm_version: str | None&lt;br&gt;- _alarm_states: dict | None&lt;br&gt;- _servers: dict[int, Server] | None&lt;br&gt;- _stream_scale: int | None&lt;br&gt;- _stream_maxfps: float | None&lt;br&gt;- _event_cache: dict&lt;br&gt;&lt;hr&gt;+ login() → bool&lt;br&gt;+ get_monitors() → list[Monitor]&lt;br&gt;+ get_run_states() → list[RunState]&lt;br&gt;+ get_servers() → list[Server]&lt;br&gt;+ update_all_monitors(monitors)&lt;br&gt;+ get_event_counts(period, archived) → dict | None&lt;br&gt;+ move_monitor(monitor, direction) → bool&lt;br&gt;+ get_active_state() → str | None&lt;br&gt;+ set_active_state(name) → dict&lt;br&gt;+ get_state(url) → dict&lt;br&gt;+ change_state(url, data) → dict&lt;br&gt;+ get_zms_url() → str&lt;br&gt;+ get_url_with_auth(url) → str&lt;br&gt;+ get_zms_url_for_monitor(raw) → str&lt;br&gt;+ get_server_url_for_monitor(raw) → str&lt;br&gt;+ get_alarm_states() → dict&lt;br&gt;+ is_available: bool&lt;br&gt;+ zm_version: str | None&lt;br&gt;+ verify_ssl: bool&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;" parent="1" vertex="1">
          <mxGeometry x="440" y="80" width="300" height="470" as="geometry" />
        </mxCell>
        <mxCell id="monclass" value="&lt;b&gt;Monitor&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- _client: ZoneMinder&lt;br&gt;- _raw_result: dict&lt;br&gt;- _scale: int | None&lt;br&gt;- _maxfps: float | None&lt;br&gt;- _last_update: float&lt;br&gt;&lt;hr&gt;+ id: int&lt;br&gt;+ name: str&lt;br&gt;+ controllable: bool&lt;br&gt;+ function: MonitorState (get/set, 1.37-aware)&lt;br&gt;+ capturing: str | None (get/set)&lt;br&gt;+ analysing: str | None (get/set)&lt;br&gt;+ recording: str | None (get/set)&lt;br&gt;+ mjpeg_image_url: str&lt;br&gt;+ still_image_url: str&lt;br&gt;+ is_recording: bool | None&lt;br&gt;+ is_available: bool&lt;br&gt;+ raw_monitor: dict&lt;br&gt;+ update_monitor()&lt;br&gt;+ get_events(period, archived) → int | None&lt;br&gt;+ set_force_alarm_state(state: bool)&lt;br&gt;+ ptz_control_command(dir, token, url) → bool&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;" parent="1" vertex="1">
          <mxGeometry x="50" y="580" width="320" height="400" as="geometry" />
        </mxCell>
        <mxCell id="srvclass" value="&lt;b&gt;Server&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;- _server_id: int&lt;br&gt;- _name: str&lt;br&gt;- _hostname: str&lt;br&gt;- _protocol: str&lt;br&gt;- _port: str | None&lt;br&gt;- _path_to_zms: str&lt;br&gt;- _path_to_index: str&lt;br&gt;- _status: str&lt;br&gt;&lt;hr&gt;+ id: int&lt;br&gt;+ name: str&lt;br&gt;+ hostname: str&lt;br&gt;+ protocol: str&lt;br&gt;+ port: str | None&lt;br&gt;+ path_to_zms: str&lt;br&gt;+ path_to_index: str&lt;br&gt;+ status: str&lt;br&gt;+ zms_url: str&lt;br&gt;+ base_url: str&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=center;" parent="1" vertex="1">
