  <diagram id="page-4-multiserver" name="Multi-Server URL Routing">
    <mxGraphModel dx="1439" dy="1210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title4" value="Multi-Server URL Routing" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="300" y="20" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ms_mon" value="Monitor&lt;br&gt;&lt;i&gt;raw_monitor[&quot;ServerId&quot;]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="100" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ms_check" value="ServerId?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="120" y="200" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ms_zero" value="Use main client URL&lt;br&gt;&lt;i&gt;self._zms_url&lt;br&gt;self._server_url&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="380" y="110" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ms_ensure" value="_ensure_servers()&lt;br&gt;&lt;i&gt;Lazy-fetch and cache&lt;br&gt;{server_id: Server}&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="100" y="330" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ms_found" value="Server found&lt;br&gt;in cache?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="110" y="440" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ms_use" value="Use server-specific URL&lt;br&gt;&lt;i&gt;server.zms_url&lt;br&gt;server.base_url&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="80" y="570" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ms_warn" value="Log warning&lt;br&gt;Fall back to main URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="380" y="450" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="me1" style="endArrow=block;endFill=1;" parent="1" source="ms_mon" target="ms_check" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me2" style="endArrow=block;endFill=1;" parent="1" source="ms_check" target="ms_zero" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me2l" value="0 or missing" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" parent="me2" vertex="1" connectable="0">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="me3" style="endArrow=block;endFill=1;" parent="1" source="ms_check" target="ms_ensure" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me3l" value="&gt; 0" style="edgeLabel;html=1;fontSize=10;fontStyle=1;" parent="me3" vertex="1" connectable="0">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="me4" style="endArrow=block;endFill=1;" parent="1" source="ms_ensure" target="ms_found" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me5" style="endArrow=block;endFill=1;" parent="1" source="ms_found" target="ms_use" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me5l" value="Yes" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#82b366;" parent="me5" vertex="1" connectable="0">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="me6" style="endArrow=block;endFill=1;" parent="1" source="ms_found" target="ms_warn" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me6l" value="No (unknown)" style="edgeLabel;html=1;fontSize=10;fontStyle=1;fontColor=#b85450;" parent="me6" vertex="1" connectable="0">
          <mxGeometry x="-0.3" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="api_box" value="&lt;b&gt;GET api/servers.json&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Called once, lazily, on first monitor with ServerId &gt; 0.&lt;br&gt;Result cached in ZoneMinder._servers as {int: Server}.&lt;br&gt;&lt;br&gt;Each Server builds its own URLs from:&lt;br&gt;• Protocol + Hostname + Port + PathToZMS → zms_url&lt;br&gt;• Protocol + Hostname + Port + dir(PathToIndex) → base_url&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;" parent="1" vertex="1">
          <mxGeometry x="600" y="200" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="usage" value="&lt;b&gt;URL Routing Used By:&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• get_zms_url_for_monitor() → Monitor image URLs (mjpeg, still)&lt;br&gt;• get_server_url_for_monitor() → PTZ control commands&lt;br&gt;&lt;br&gt;Single-server setups (ServerId=0 or missing) are unaffected — &lt;br&gt;they always use the main client URLs without hitting the servers API.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;" parent="1" vertex="1">
          <mxGeometry x="600" y="420" width="400" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
